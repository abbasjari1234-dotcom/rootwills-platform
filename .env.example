# ==============================================================================
# ROOTWILLS FOODSERVICE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit real secret keys, credentials, or production tokens to git.
# ==============================================================================

# 1. Site Domain URL (Used for sitemaps, openGraph metadata, and OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://www.rootwills.co.uk
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification_token

# 2. Supabase Cloud Database & Authentication
# Copy from Supabase Dashboard -> Project Settings -> API
# NOTE: The anon/publishable key is safe client-side ONLY with RLS enabled on all tables.
# The service role key bypasses RLS and MUST NEVER be exposed client-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 3. Database Connection String (Prisma ORM / Direct PostgreSQL Connection with TLS)
# Copy from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require&pgbouncer=true

# 4. Resend Transactional Email Engine
# Used for trade account confirmations, order summaries, and driver POD receipts
RESEND_API_KEY=re_your_resend_api_key
CONCIERGE_NOTIFICATION_EMAIL=sales@rootwills.co.uk

# 5. Stripe Payments (Cards, Apple Pay, Google Pay)
# Copy from Stripe Dashboard -> Developers -> API keys & Webhooks
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# 6. GoCardless (Automated UK BACS Direct Debit)
# Copy from GoCardless Dashboard -> Developers -> Access Tokens & Webhooks
GOCARDLESS_ACCESS_TOKEN=live_your_gocardless_token
GOCARDLESS_WEBHOOK_SECRET=your_gocardless_webhook_secret
GOCARDLESS_ENVIRONMENT=live # 'live' or 'sandbox'

# 7. AI Assistant Configuration & Cost Protection
AI_ENABLED=true
AI_MAX_INPUT_LENGTH=1000

# 8. Development / Sandbox Auth Overrides (NON-PRODUCTION ONLY)
# Used for local CLI scripts or local demo access without sending OTP/magic-links
DEMO_AUTH_PASSWORD=
DEFAULT_PROVISIONING_PASSWORD=

# 9. Optional Geocoding & Companies House APIs
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
COMPANIES_HOUSE_API_KEY=
